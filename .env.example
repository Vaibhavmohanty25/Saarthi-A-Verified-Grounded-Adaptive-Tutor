# ==============================================================================
# Saarthi Environment Configuration Template
# Copy this file to .env and configure your keys.
# ==============================================================================

# --- Primary LLM Keys ---
GROQ_API_KEY=
GEMINI_API_KEY=
REPLICATE_API_KEY=

# --- Model Selection ---
REPLICATE_MODEL=openai/gpt-4o-mini
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_MODEL=gemini-2.5-flash

# --- Optional Pod B Grounding & Embeddings Configuration ---
# Embeddings: hash | auto | openai | gemini | local
EMBEDDING_PROVIDER=hash
# LLM_PROVIDER=auto          # auto | gemini | none
# Reranking: lexical | auto | cross-encoder
RERANK_PROVIDER=lexical
# VERIFY_WITH_LLM=0          # 1 = extra LLM verification pass on retrieved claims
# POD_B_RATE_LIMIT=60        # Max queries per minute per client IP
# POD_B_ADMIN_TOKEN=         # Optional admin token for indexing/rebuild endpoints

# --- Uploaded Course API ---
# SAARTHI_DB_PATH=saarthi_sessions.db
# SAARTHI_MAX_UPLOAD_BYTES=52428800
# SAARTHI_LEGACY_TOKEN=       # Protect demo routes with X-Legacy-Token on shared servers
# SAARTHI_GROUNDING_RESULTS=  # Optional path to a recorded grounding evaluation
